+// ---- Virtual targets --------------------------------------------------------------------------------------------------
+// Things to lock on to that are not actors, handed over by another mod (a mob that lives in another game's world and has no Skyrim
+// actor, say). There is nothing to draw a reticle on or to aim a projectile at, so a virtual target gets the camera, the facing and
+// the strafing of a target lock, and nothing else.
+
+static std::int64_t SteadyNowMs()
+{
+	return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+bool DirectionalMovementHandler::AreVirtualTargetsFresh() const
+{
+	const std::int64_t stamp = _virtualTargetsStamp;
+	return stamp != 0 && SteadyNowMs() - stamp < 1000;
+}
+
+void DirectionalMovementHandler::SetVirtualTargets(const TDM_API::VirtualTarget* a_targets, std::uint32_t a_count)
+{
+	_virtualTargetsStamp = SteadyNowMs();
+	std::lock_guard<std::mutex> lock(_virtualTargetsMutex);
+	_virtualTargets.clear();
+	for (std::uint32_t i = 0; a_targets && i < a_count; ++i) {
+		if (a_targets[i].id != 0) {
+			_virtualTargets[a_targets[i].id] = a_targets[i];
+		}
+	}
+}
+
+void DirectionalMovementHandler::SetIgnoredActors(const std::uint32_t* a_formIds, std::uint32_t a_count)
+{
+	std::lock_guard<std::mutex> lock(_virtualTargetsMutex);
+	_ignoredActors.clear();
+	for (std::uint32_t i = 0; a_formIds && i < a_count; ++i) {
+		_ignoredActors.insert(static_cast<RE::FormID>(a_formIds[i]));
+	}
+}
+
+bool DirectionalMovementHandler::IsActorIgnored(RE::FormID a_formId) const
+{
+	std::lock_guard<std::mutex> lock(_virtualTargetsMutex);
+	return _ignoredActors.contains(a_formId);
+}
+
+bool DirectionalMovementHandler::GetVirtualTargetPosition(RE::NiPoint3& a_out) const
+{
+	const std::uint32_t id = _virtualTargetId;
+	if (id == 0 || !AreVirtualTargetsFresh()) {
+		return false;
+	}
+	std::lock_guard<std::mutex> lock(_virtualTargetsMutex);
+	const auto it = _virtualTargets.find(id);
+	if (it == _virtualTargets.end()) {
+		return false;
+	}
+	a_out = RE::NiPoint3(it->second.x, it->second.y, it->second.z);
+	return true;
+}
+
+bool DirectionalMovementHandler::CheckVirtualTarget() const
+{
+	auto playerCharacter = RE::PlayerCharacter::GetSingleton();
+	RE::NiPoint3 position;
+	if (!playerCharacter || !GetVirtualTargetPosition(position)) {  // gone: the mod that gave it left it out
+		return false;
+	}
+
+	if (RE::MenuTopicManager::GetSingleton()->speaker) {
+		return false;
+	}
+
+	return playerCharacter->GetPosition().GetDistance(position) <= Settings::fTargetLockDistance * _targetLockDistanceHysteresis;
+}
+
+float DirectionalMovementHandler::ScoreTargetPosition(TargetLockSelectionMode a_mode, const RE::NiPoint3& a_position, const RE::NiPoint3& a_playerPosition) const
+{
+	RE::NiPoint3 direction = a_position - a_playerPosition;
+	const float distance = direction.Unitize();
+	if (a_mode == TargetLockSelectionMode::kClosest) {
+		return distance;
+	}
+
+	auto playerCamera = RE::PlayerCamera::GetSingleton();
+	if (!playerCamera || !playerCamera->currentState) {
+		return distance;
+	}
+	RE::NiQuaternion cameraRotation;
+	playerCamera->currentState->GetRotation(cameraRotation);
+	auto cameraForward = RotateVector(RE::NiPoint3(0.f, 1.f, 0.f), cameraRotation);
+	cameraForward.z = 0.f;
+	cameraForward.Unitize();
+	const float dot = cameraForward.Dot(direction);
+
+	// lower is better, as with the distance
+	return a_mode == TargetLockSelectionMode::kCenter ? -dot : distance * (1.f - dot);
+}
+
+std::uint32_t DirectionalMovementHandler::FindVirtualTarget(TargetLockSelectionMode a_mode, float& a_scoreOut, bool a_bSkipCurrent) const
+{
+	a_scoreOut = FLT_MAX;
+
+	auto playerCharacter = RE::PlayerCharacter::GetSingleton();
+	RE::NiPoint3 playerPosition;
+	if (!AreVirtualTargetsFresh() || !playerCharacter || !GetTorsoPos(playerCharacter, playerPosition)) {
+		return 0;
+	}
+
+	std::uint32_t best = 0;
+	std::lock_guard<std::mutex> lock(_virtualTargetsMutex);
+	for (const auto& entry : _virtualTargets) {
+		if (a_bSkipCurrent && entry.first == _virtualTargetId) {
+			continue;
+		}
+		const RE::NiPoint3 position(entry.second.x, entry.second.y, entry.second.z);
+		if (playerPosition.GetDistance(position) > Settings::fTargetLockDistance) {
+			continue;
+		}
+		const float score = ScoreTargetPosition(a_mode, position, playerPosition);
+		if (score < a_scoreOut) {
+			a_scoreOut = score;
+			best = entry.first;
+		}
+	}
+	return best;
+}
+
+void DirectionalMovementHandler::SetVirtualTarget(std::uint32_t a_id)
+{
+	if (_virtualTargetId == a_id) {
+		return;
+	}
+
+	if (a_id != 0 && _target) {
+		SetTarget(RE::ActorHandle());  // an actor was locked on to: let it go (its reticle, health bar and headtracking too)
+	}
+
+	_virtualTargetId = a_id;
+
+	if (a_id != 0) {
+		SetTargetPoint(RE::NiPointer<RE::NiAVObject>());
+		SetHeadtrackTarget(RE::HighProcessData::HEAD_TRACK_TYPE::kDialogue, nullptr);
+		RemoveTargetLockReticle();
+	}
+
+	UpdateVirtualTargetBar();  // TrueHUD's name and health bar: the stand-in's while locked on, none once it isn't
+}
+
+// The name and health bar of the virtual target locked on to. There is no actor, so TrueHUD cannot give it one; it is drawn
+// straight into Skyrim's HUD with ActionScript's drawing calls, above the target, as a bar and a name like an NPC's. All of it
+// happens on the UI thread, and a HUD that is not there (or does not answer) just means no bar.
+namespace
+{
+	constexpr double kVirtualBarWidth = 130.0;   // stage units, for a 720 high stage; the clip is scaled to the real one
+	constexpr double kVirtualBarHeight = 9.0;
+
+	struct VirtualBarUi
+	{
+		const void*  movie = nullptr;
+		RE::GFxValue container;
+		RE::GFxValue fill;
+		RE::GFxValue text;
+		std::string  shownName;
+		bool         ready = false;
+	};
+	VirtualBarUi* virtualBarUi = nullptr;  // never freed: its movie may be gone by then
+
+	void DrawBarRect(RE::GFxValue& a_clip, double a_x0, double a_y0, double a_x1, double a_y1, double a_color, double a_alpha)
+	{
+		RE::GFxValue a[2];
+		a[0].SetNumber(a_color);
+		a[1].SetNumber(a_alpha);
+		a_clip.Invoke("beginFill", nullptr, a, 2);
+		RE::GFxValue p[2];
+		const double xs[5] = { a_x0, a_x1, a_x1, a_x0, a_x0 };
+		const double ys[5] = { a_y0, a_y0, a_y1, a_y1, a_y0 };
+		for (int i = 0; i < 5; ++i) {
+			p[0].SetNumber(xs[i]);
+			p[1].SetNumber(ys[i]);
+			a_clip.Invoke(i == 0 ? "moveTo" : "lineTo", nullptr, p, 2);
+		}
+		a_clip.Invoke("endFill", nullptr, nullptr, 0);
+	}
+
+	std::string EscapeHtml(const std::string& a_text)
+	{
+		std::string out;
+		for (const char c : a_text) {
+			switch (c) {
+			case '&': out += "&amp;"; break;
+			case '<': out += "&lt;"; break;
+			case '>': out += "&gt;"; break;
+			default: out += c; break;
+			}
+		}
+		return out;
+	}
+}
+
+void DirectionalMovementHandler::UpdateVirtualTargetBar()
+{
+	bool          show = false;
+	std::string   name;
+	float         health = -1.0f;
+	RE::NiPoint3  position;
+	if (_virtualTargetId != 0 && AreVirtualTargetsFresh()) {
+		std::lock_guard<std::mutex> lock(_virtualTargetsMutex);
+		if (const auto it = _virtualTargets.find(_virtualTargetId); it != _virtualTargets.end()) {
+			show = true;
+			name.assign(it->second.name, strnlen(it->second.name, sizeof(it->second.name)));
+			health = it->second.health;
+			position = RE::NiPoint3(it->second.x, it->second.y, it->second.z);
+		}
+	}
+
+	static bool shownLast = false;
+	if (!show && !shownLast) {
+		return;  // nothing was shown, nothing is
+	}
+	shownLast = show;
+
+	const auto* tasks = SKSE::GetTaskInterface();
+	if (!tasks) {
+		return;
+	}
+	tasks->AddUITask([show, name, health, position]() {
+		auto* ui = RE::UI::GetSingleton();
+		auto  hud = ui ? ui->GetMenu(RE::HUDMenu::MENU_NAME) : RE::GPtr<RE::IMenu>();
+		if (!hud || !hud->uiMovie) {
+			return;
+		}
+		RE::GFxMovieView* movie = hud->uiMovie.get();
+		if (!virtualBarUi || virtualBarUi->movie != movie) {
+			virtualBarUi = new VirtualBarUi();
+			virtualBarUi->movie = movie;
+		}
+		VirtualBarUi& bar = *virtualBarUi;
+
+		if (!bar.ready) {
+			if (!show) {
+				return;
+			}
+			RE::GFxValue root;
+			if (!movie->GetVariable(&root, "_root") || !root.IsObject()) {
+				return;
+			}
+			RE::GFxValue depth;
+			root.Invoke("getNextHighestDepth", &depth, nullptr, 0);
+			RE::GFxValue args[6];
+			args[0].SetString("tdm_virtualTargetBar");
+			args[1].SetNumber(depth.IsNumber() ? depth.GetNumber() : 9000.0);
+			root.Invoke("createEmptyMovieClip", &bar.container, args, 2);
+			if (!bar.container.IsObject()) {
+				return;
+			}
+			RE::GFxValue back;
+			args[0].SetString("back");
+			args[1].SetNumber(1);
+			bar.container.Invoke("createEmptyMovieClip", &back, args, 2);
+			DrawBarRect(back, -kVirtualBarWidth * 0.5, 0.0, kVirtualBarWidth * 0.5, kVirtualBarHeight, 0x000000, 60.0);
+			args[0].SetString("fill");
+			args[1].SetNumber(2);
+			bar.container.Invoke("createEmptyMovieClip", &bar.fill, args, 2);
+			args[0].SetString("name");
+			args[1].SetNumber(3);
+			args[2].SetNumber(-kVirtualBarWidth);
+			args[3].SetNumber(-26.0);
+			args[4].SetNumber(kVirtualBarWidth * 2.0);
+			args[5].SetNumber(24.0);
+			bar.container.Invoke("createTextField", &bar.text, args, 6);
+			RE::GFxValue flag;
+			flag.SetBoolean(true);
+			bar.text.SetMember("html", flag);
+			flag.SetBoolean(false);
+			bar.text.SetMember("selectable", flag);
+			bar.ready = true;
+		}
+
+		RE::GFxValue::DisplayInfo info;
+		if (!show) {
+			info.SetVisible(false);
+			bar.container.SetDisplayInfo(info);
+			return;
+		}
+
+		float nx = 0.0f, ny = 0.0f, depthZ = 0.0f;
+		RE::NiCamera::WorldPtToScreenPt3((float(*)[4])g_worldToCamMatrix, *g_viewPort, position, nx, ny, depthZ, 1e-5f);
+		if (depthZ < 0.0f) {  // behind the camera
+			info.SetVisible(false);
+			bar.container.SetDisplayInfo(info);
+			return;
+		}
+		ny = 1.0f - ny;  // Flash's y goes down
+
+		const RE::GRectF rect = movie->GetVisibleFrameRect();
+		const float      stageWidth = rect.right - rect.left;
+		const float      stageHeight = rect.bottom - rect.top;
+		const double     scale = stageHeight / 720.0 * 100.0;
+		const float      half = static_cast<float>(kVirtualBarWidth * 0.5 * scale / 100.0);
+		float            x = rect.left + stageWidth * nx;
+		float            y = rect.top + stageHeight * ny - stageHeight * 0.10f;  // above the target
+		x = std::clamp(x, rect.left + half, rect.right - half);
+		y = std::clamp(y, rect.top + stageHeight * 0.06f, rect.bottom - stageHeight * 0.06f);
+
+		bar.fill.Invoke("clear", nullptr, nullptr, 0);
+		if (health >= 0.0f) {
+			const double fraction = std::clamp(static_cast<double>(health), 0.0, 1.0);
+			if (fraction > 0.0) {
+				DrawBarRect(bar.fill, -kVirtualBarWidth * 0.5, 0.0, -kVirtualBarWidth * 0.5 + kVirtualBarWidth * fraction, kVirtualBarHeight, 0xB02020, 100.0);
+			}
+		}
+
+		if (name != bar.shownName) {
+			bar.shownName = name;
+			const std::string html = "<font face=\"$EverywhereFont\" size=\"18\" color=\"#FFFFFF\"><p align=\"center\">" + EscapeHtml(name) + "</p></font>";
+			RE::GFxValue text;
+			text.SetString(html.c_str());
+			bar.text.SetMember("htmlText", text);
+		}
+
+		info.SetVisible(true);
+		info.SetPosition(x, y);
+		info.SetScale(scale, scale);
+		bar.container.SetDisplayInfo(info);
+	});
+}
+
+void DirectionalMovementHandler::SwitchVirtualTarget(Direction a_direction)
+{
+	auto playerCharacter = RE::PlayerCharacter::GetSingleton();
+	RE::NiPoint3 playerPosition;
+	RE::NiPoint3 currentPosition;
+	if (!AreVirtualTargetsFresh() || !playerCharacter || !GetTorsoPos(playerCharacter, playerPosition) || !GetVirtualTargetPosition(currentPosition)) {
+		return;
+	}
+
+	RE::NiPoint2 currentScreenPosition;
+	float currentDepth;
+	RE::NiCamera::WorldPtToScreenPt3((float(*)[4])g_worldToCamMatrix, *g_viewPort, currentPosition, currentScreenPosition.x, currentScreenPosition.y, currentDepth, 1e-5f);
+
+	constexpr RE::NiPoint2 upVector{ 0.f, 1.f };
+	constexpr RE::NiPoint2 downVector{ 0.f, -1.f };
+	constexpr RE::NiPoint2 leftVector{ -1.f, 0.f };
+	constexpr RE::NiPoint2 rightVector{ 1.f, 0.f };
+
+	std::uint32_t best = 0;
+	float bestScreenDistance = FLT_MAX;
+	{
+		std::lock_guard<std::mutex> lock(_virtualTargetsMutex);
+		for (const auto& entry : _virtualTargets) {
+			if (entry.first == _virtualTargetId) {
+				continue;
+			}
+			const RE::NiPoint3 position(entry.second.x, entry.second.y, entry.second.z);
+			if (playerPosition.GetDistance(position) > Settings::fTargetLockDistance) {
+				continue;
+			}
+
+			RE::NiPoint2 newScreenPosition;
+			float newDepth;
+			RE::NiCamera::WorldPtToScreenPt3((float(*)[4])g_worldToCamMatrix, *g_viewPort, position, newScreenPosition.x, newScreenPosition.y, newDepth, 1e-5f);
+			if (newDepth < 0.f) {  // offscreen
+				continue;
+			}
+
+			bool bIsCorrectDirection = false;
+			RE::NiPoint2 directionVector;
+			switch (a_direction) {
+			case Direction::kLeft:
+				bIsCorrectDirection = newScreenPosition.x < currentScreenPosition.x;
+				directionVector = leftVector;
+				break;
+			case Direction::kRight:
+				bIsCorrectDirection = newScreenPosition.x > currentScreenPosition.x;
+				directionVector = rightVector;
+				break;
+			case Direction::kForward:
+			case Direction::kUp:
+				bIsCorrectDirection = newScreenPosition.y > currentScreenPosition.y;
+				directionVector = upVector;
+				break;
+			case Direction::kBack:
+			case Direction::kDown:
+				bIsCorrectDirection = newScreenPosition.y < currentScreenPosition.y;
+				directionVector = downVector;
+				break;
+			}
+
+			if (bIsCorrectDirection) {
+				RE::NiPoint2 distanceVector = newScreenPosition - currentScreenPosition;
+				const float screenDistance = distanceVector.Unitize();
+				const float directionMult = 2.f - directionVector.Dot(distanceVector);
+				if (screenDistance * directionMult < bestScreenDistance) {
+					bestScreenDistance = screenDistance * directionMult;
+					best = entry.first;
+				}
+			}
+		}
+	}
+
+	if (best != 0) {
+		SetVirtualTarget(best);
+		_lastTargetSwitchDirection = a_direction;
+		_lastTargetSwitchTimer = 0.25f;
+	}
