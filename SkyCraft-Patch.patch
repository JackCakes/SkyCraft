+			return;
+		}
+		double gap = Math.hypot(this.mob.getX() - npc.getX(), this.mob.getZ() - npc.getZ()) - this.mob.getBbWidth() * 0.5 - npc.getBbWidth() * 0.5;
+		if (gap > STRIKE_REACH || Math.abs(this.mob.getY() - npc.getY()) > Math.max(this.mob.getBbHeight(), npc.getBbHeight())) {
+			return;
+		}
+		if (!SkyrimMobs.canSee(this.mob, npc)) {
+			return;
+		}
+		this.mob.getLookControl().setLookAt(npc, 30.0F, 30.0F);
+		this.mob.swing(InteractionHand.MAIN_HAND, this.mob.getMainHandItem().getAttackAnimation());
+		this.mob.doHurtTarget(level, npc);
+		this.nextStrike = now + STRIKE_EVERY;
+	}
+
+	/** A mob that fights with its body or a held weapon (not one that shoots, or swells like a creeper). */
+	private static boolean isMelee(Mob mob) {
+		if (mob.getAttribute(Attributes.ATTACK_DAMAGE) == null || !SkyrimMobs.walker(mob)) {
+			return false;
+		}
+		Item held = mob.getMainHandItem().getItem();
+		return !(held instanceof BowItem || held instanceof CrossbowItem) && !"creeper".equals(BuiltInRegistries.ENTITY_TYPE.getKey(mob.getType()).getPath());
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/MobProxies.java b/fabric/src/main/java/dev/skycraft/combat/MobProxies.java
new file mode 100644
index 0000000..712fbd6
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/MobProxies.java
@@ -0,0 +1,192 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+
+/**
+ * Gives Minecraft's mobs a presence Skyrim understands. Skyrim's combat AI, its lock-on mods and its spells can only deal with an
+ * actor, so every mob that matters is reported to Skyrim ({@link Proto#EV_MOB_PROXY}), which keeps an invisible stand-in actor where
+ * the mob stands. A mob gets one for either of two reasons:
+ *
+ * <ul>
+ * <li>It is a hostile mob near one of Skyrim's NPCs. The NPCs fight the stand-in exactly as they would fight a wolf or a bandit:
+ * weapon out, closing in, blocking, shooting, civilians running.
+ * <li>It is near the player, whatever it is. The stand-in is what the player locks on to and what Skyrim's spells hit. These are
+ * flagged {@link Proto#MOB_PROXY_TARGET_ONLY} when no NPC has business with the mob, so Skyrim's NPCs leave them alone.
+ * </ul>
+ *
+ * What Skyrim does to a stand-in comes back as damage to the real mob ({@link Proto#IN_PROXY_HURT}), from the player when the player
+ * did it; what the mob does to an NPC is Minecraft's, as before.
+ *
+ * <p>An NPC Skyrim hasn't put into such a fight is still handled by {@link NpcFightsBack}, so if Skyrim can't make stand-ins nothing
+ * is lost. Turn this off with {@code -Dskycraft.mobProxies=false}. {@code -Dskycraft.mobTargets=hostile} gives the player's
+ * stand-ins to hostile mobs only (the default is every mob), {@code =off} to none.
+ */
+final class MobProxies {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobProxies"));
+	private static final String TARGETS = System.getProperty("skycraft.mobTargets", "all").toLowerCase(java.util.Locale.ROOT);
+	/** Mobs this close to an NPC (blocks) get a stand-in. */
+	private static final double RANGE = 30.0;
+	/** Mobs this close to the player (blocks) get one to be locked on to and hit by spells. */
+	private static final double PLAYER_RANGE = 40.0;
+	/** At most this many mob bodies at once, the ones that matter most first. A body is a collision box, cheap beside the actor stand-in it replaces. */
+	private static final int MAX = 48;
+	private static final Set<Integer> LIVE = new HashSet<>();
+	/** Mob id -> game time its name was last sent. Skyrim names each stand-in after its mob (it would otherwise show as a skeever). */
+	private static final Map<Integer, Long> NAME_SENT = new HashMap<>();
+	private static final long NAME_RESEND_TICKS = 100L;
+
+	private MobProxies() {
+	}
+
+	/** One mob that is to have a stand-in. */
+	private static final class Want {
+		final Mob mob;
+		/** Skyrim's NPCs may fight it (a hostile mob near one of them). */
+		boolean npcFight;
+		/** Squared distance to whoever it matters to (the nearest NPC it is a threat to, or the player). */
+		double near = Double.MAX_VALUE;
+
+		Want(Mob mob) {
+			this.mob = mob;
+		}
+	}
+
+	static void tick(ServerLevel level, Collection<SkyrimActorEntity> actors, List<ServerPlayer> players) {
+		final boolean forPlayer = !"off".equals(TARGETS) && !players.isEmpty();
+		if (!ENABLED || !SkyLink.active() || (actors.isEmpty() && !forPlayer)) {
+			if (SkyLink.active()) {
+				for (Integer id : LIVE) {
+					SkyLink.pushEvent(Proto.EV_MOB_PROXY, id, 0.0F, 0.0F, 0.0F, 0.0F, Proto.MOB_PROXY_GONE); // nobody to need them: the stand-ins go, not left standing
+				}
+			}
+			LIVE.clear();
+			NAME_SENT.clear();
+			return;
+		}
+		Map<Mob, Want> found = new LinkedHashMap<>();
+		for (SkyrimActorEntity npc : actors) {
+			if (!npc.isAlive()) {
+				continue;
+			}
+			for (Mob mob : level.getEntitiesOfClass(Mob.class, npc.getBoundingBox().inflate(RANGE, 6.0, RANGE))) {
+				if (!mob.isAlive() || !(mob.getType().getCategory() == MobCategory.MONSTER || mob.getTarget() instanceof SkyrimActorEntity)) {
+					continue;
+				}
+				Want want = found.computeIfAbsent(mob, Want::new);
+				want.npcFight = true;
+				want.near = Math.min(want.near, mob.distanceToSqr(npc));
+			}
+		}
+		if (forPlayer) {
+			final boolean hostileOnly = "hostile".equals(TARGETS);
+			for (ServerPlayer player : players) {
+				if (player.level() != level || !player.isAlive() || player.isSpectator()) {
+					continue;
+				}
+				for (Mob mob : level.getEntitiesOfClass(Mob.class, player.getBoundingBox().inflate(PLAYER_RANGE, 16.0, PLAYER_RANGE))) {
+					if (!mob.isAlive() || mob.isInvisible() || mob.isAlliedTo(player) || mob.hasPassenger(player)) {
+						continue;
+					}
+					if (hostileOnly && mob.getType().getCategory() != MobCategory.MONSTER) {
+						continue;
+					}
+					Want want = found.computeIfAbsent(mob, Want::new);
+					want.near = Math.min(want.near, mob.distanceToSqr(player));
+				}
+			}
+		}
+		// Hysteresis: a mob that already has a stand-in keeps it until it is well out of range (and sorts ahead of newcomers
+		// below), so mobs drifting across the edge or a busier moment don't swap stand-ins in and out (no stable lock-on).
+		if (forPlayer) {
+			for (Integer id : LIVE) {
+				if (!(level.getEntity(id) instanceof Mob mob) || !mob.isAlive() || found.containsKey(mob)) {
+					continue;
+				}
+				// A mob that has a stand-in keeps it for as long as it lives and is loaded, however far it has wandered: the stand-in goes
+				// when the mob does, not when it passes some distance. (Distance only decides who is dropped if there are more than MAX.)
+				Want want = found.computeIfAbsent(mob, Want::new);
+				for (ServerPlayer player : players) {
+					if (player.level() == level) {
+						want.near = Math.min(want.near, mob.distanceToSqr(player));
+					}
+				}
+			}
+		}
+		// Mobs that are after one of Skyrim's NPCs come first (a skeleton shooting from across a field must get a stand-in, so
+		// the NPC it shoots can turn on it, before a mob that is only standing near one), then the nearest to whoever needs it.
+		List<Want> ordered = new ArrayList<>(found.values());
+		ordered.sort((a, b) -> {
+			boolean aFoe = a.mob.getTarget() instanceof SkyrimActorEntity, bFoe = b.mob.getTarget() instanceof SkyrimActorEntity;
+			if (aFoe != bFoe) {
+				return aFoe ? -1 : 1;
+			}
+			boolean aLive = LIVE.contains(a.mob.getId()), bLive = LIVE.contains(b.mob.getId());
+			return aLive != bLive ? (aLive ? -1 : 1) : Double.compare(a.near, b.near);
+		});
+		Map<Integer, Want> wanted = new LinkedHashMap<>();
+		for (int i = 0; i < Math.min(MAX, ordered.size()); i++) {
+			wanted.put(ordered.get(i).mob.getId(), ordered.get(i));
+		}
+		final long now = level.getGameTime();
+		for (Want want : wanted.values()) {
+			Mob mob = want.mob;
+			Long lastName = NAME_SENT.get(mob.getId());
+			final boolean roomy = SkyLink.eventRingFree() > 160; // Skyrim is behind: position updates matter, names and vitals can wait
+			if (roomy && (lastName == null || now - lastName >= NAME_RESEND_TICKS)) {  // before the position, so a new stand-in is named at once
+				sendName(mob);
+				NAME_SENT.put(mob.getId(), now);
+			}
+			// The mob's vitals go first, so Skyrim knows the mob's width before it makes the stand-in (it is sized from width and height). Its
+			// health (1:1: Skyrim's lock-on bar shows exactly this), where its eyes are, and which way it is moving.
+			if (roomy) {
+				var motion = mob.getDeltaMovement();
+				SkyLink.pushEvent(Proto.EV_MOB_VITALS, mob.getId(), mob.getHealth(), mob.getMaxHealth(), mob.getEyeHeight(), mob.getBbWidth(),
+					Float.floatToRawIntBits((float) (motion.x * 20.0)), Float.floatToRawIntBits((float) (motion.z * 20.0)));
+			}
+			// The mob's height goes in the weapon field (the stand-in is sized to it, so the head is where the mob's is).
+			SkyLink.pushEvent(Proto.EV_MOB_PROXY, mob.getId(), (float) mob.getX(), (float) mob.getY(), (float) mob.getZ(), mob.getYRot(),
+				want.npcFight ? 0 : Proto.MOB_PROXY_TARGET_ONLY, Float.floatToRawIntBits(mob.getBbHeight()));
+		}
+
+		for (Integer id : new ArrayList<>(LIVE)) {
+			if (!wanted.containsKey(id)) {
+				SkyLink.pushEvent(Proto.EV_MOB_PROXY, id, 0.0F, 0.0F, 0.0F, 0.0F, Proto.MOB_PROXY_GONE); // dead or out of range: Skyrim drops the stand-in
+			}
+		}
+		LIVE.clear();
+		LIVE.addAll(wanted.keySet());
+		NAME_SENT.keySet().retainAll(wanted.keySet());
+	}
+
+	/** Tells Skyrim the mob's name (its custom name if it has one), up to 24 plain ASCII characters. */
+	private static void sendName(Mob mob) {
+		byte[] raw = new byte[24];
+		String name = mob.getName().getString();
+		if (!mob.hasCustomName() && !name.isEmpty()) {
+			name = Character.toUpperCase(name.charAt(0)) + name.substring(1); // some mobs' names come through lowercase ("chicken")
+		}
+		int n = 0;
+		for (int i = 0; i < name.length() && n < raw.length; i++) {
+			char c = name.charAt(i);
+			raw[n++] = (byte) (c >= 32 && c < 127 ? c : '?');
+		}
+		ByteBuffer b = ByteBuffer.wrap(raw).order(ByteOrder.LITTLE_ENDIAN);
+		SkyLink.pushEvent(Proto.EV_MOB_NAME, mob.getId(), Float.intBitsToFloat(b.getInt()), Float.intBitsToFloat(b.getInt()),
+			Float.intBitsToFloat(b.getInt()), Float.intBitsToFloat(b.getInt()), b.getInt(), b.getInt());
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/NoShove.java b/fabric/src/main/java/dev/skycraft/combat/NoShove.java
new file mode 100644
index 0000000..8e94f08
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/NoShove.java
@@ -0,0 +1,26 @@
+package dev.skycraft.combat;
+
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Minecraft shoves whatever it hurts. For a melee blow that is just in the way: a mob that is hit
+ * flies back out of reach of the fight, and Skyrim's NPCs have to chase it. A blow through here does
+ * all the damage, armor, hurt sounds and anger of any other, and leaves the victim's movement alone.
+ * Shots keep their knockback: it is what holds an enemy off an archer.
+ */
+final class NoShove {
+	private NoShove() {
+	}
+
+	static boolean hurt(ServerLevel level, LivingEntity victim, DamageSource source, float damage) {
+		Vec3 before = victim.getDeltaMovement();
+		boolean hurt = victim.hurtServer(level, source, damage);
+		if (hurt && !victim.isDeadOrDying()) {
+			victim.setDeltaMovement(before);
+		}
+		return hurt;
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/NpcFightsBack.java b/fabric/src/main/java/dev/skycraft/combat/NpcFightsBack.java
new file mode 100644
index 0000000..77638f0
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/NpcFightsBack.java
@@ -0,0 +1,198 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.SkyCraft;
+import dev.skycraft.link.Proto;
+import dev.skycraft.link.SkyLink;
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+
+/**
+ * Skyrim's NPCs fight the Minecraft mobs that come for them, the way they would fight a Skyrim enemy.
+ * Skyrim's own AI has no idea a zombie exists, so this does what its combat would, step by step:
+ *
+ * <ol>
+ * <li>The moment a hostile mob is about (seen, or already after the NPC), the NPC goes on guard:
+ * Skyrim is told ({@link Proto#EV_NPC_STANCE}) to take the weapon out and turn the NPC to face the
+ * danger, and to keep turning as it moves. It stays on guard, weapon out, for as long as any mob is
+ * around and for a good few seconds after, the way Skyrim's NPCs linger after a fight.
+ * <li>Whoever is hitting the NPC is dealt with first; otherwise the nearest. A blow lands on the first
+ * mob in reach, and from an archer's range on one in the open. Each blow is Skyrim's own attack
+ * animation ({@link Proto#EV_NPC_SWING}); its damage comes from the weapon in the NPC's hand
+ * (a guard's sword hits harder than a farmer's fists) and is dealt through Minecraft's damage
+ * ({@code mobAttack}: armour, knockback, the mob turning on the NPC in return).
+ * <li>When the last mob is dead or gone, the NPC stands down: the weapon goes away.
+ * </ol>
+ *
+ * <p>Anyone not a fighter (a shopkeeper, a farmer) still defends itself against a mob that is on top of it.
+ * An NPC in a fight Skyrim runs itself is left alone. Turn it off with {@code -Dskycraft.npcsFightBack=false}.
+ */
+final class NpcFightsBack {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.npcsFightBack"));
+	/** How far past its own body an NPC's blow reaches, in blocks. */
+	private static final double REACH = 2.4;
+	/** A hostile mob this close makes a fighter take out its weapon, in sight or not (it hears it). */
+	private static final double ALERT = 22.0;
+	/** A mob after the NPC makes any NPC defend itself from this far. */
+	private static final double SELF_DEFENCE = 8.0;
+	/** Anyone shorter than this (children, small creatures) keeps out of it. */
+	private static final float MIN_HEIGHT = 1.2F;
+	/** Ticks the weapon takes to come out before the first blow. */
+	private static final long DRAW_TICKS = 22;
+	/** Ticks without a mob about before the weapon goes away (Skyrim's NPCs keep it out a good while after a fight). */
+	private static final long STAND_DOWN_TICKS = 160;
+	/** How often a ready NPC is told where to look, so it keeps facing the danger. */
+	private static final long FACE_EVERY = 4;
+	/** An archer shoots from this far. */
+	private static final double BOW_RANGE = 20.0;
+	/** Ticks from a swing starting to it landing (melee), and from the string being drawn to the arrow arriving (bow). */
+	private static final long MELEE_DELAY = 7, BOW_DELAY = 22;
+	/** If Skyrim keeps the weapon away, the NPC fights anyway after this long. */
+	private static final long STUCK_TICKS = 100;
+	/** Skyrim weapon damage to Minecraft damage (an iron sword's 7 is about a stone sword's 5). */
+	private static final float SKYRIM_TO_MC = 0.85F;
+	private static int swingLogs;
+
+	/** One NPC's fight so far. */
+	private static final class Stance {
+		long lastThreat;
+		long readyAt;
+		long nextSwing;
+		long lastFaced = Long.MIN_VALUE;
+		Mob victim;
+		float damage;
+		long landAt;
+	}
+
+	private static final Map<Integer, Stance> STANCES = new HashMap<>();
+
+	private NpcFightsBack() {
+	}
+
+	static void tick(ServerLevel level, Collection<SkyrimActorEntity> actors) {
+		if (!ENABLED || !SkyLink.active()) {
+			STANCES.clear();
+			return;
+		}
+		long now = level.getGameTime();
+		Set<Integer> present = new HashSet<>();
+		for (SkyrimActorEntity npc : actors) {
+			present.add(npc.formId());
+			if (!npc.isAlive() || npc.getBbHeight() < MIN_HEIGHT || npc.inSkyrimCombat()) {
+				STANCES.remove(npc.formId()); // (Skyrim looks after the weapon of one in a fight of its own)
+				continue;
+			}
+			List<Mob> threats = threats(level, npc);
+			Stance stance = STANCES.get(npc.formId());
+			if (threats.isEmpty()) {
+				if (stance != null && now - stance.lastThreat >= STAND_DOWN_TICKS) {
+					SkyLink.pushEvent(Proto.EV_NPC_STANCE, npc.formId(), (float) npc.getX(), (float) npc.getY(), (float) npc.getZ(), 0.0F, 0);
+					STANCES.remove(npc.formId());
+				}
+				continue;
+			}
+			if (stance == null) {
+				stance = new Stance();
+				stance.readyAt = now + DRAW_TICKS;
+				STANCES.put(npc.formId(), stance);
+			}
+			stance.lastThreat = now;
+			boolean bow = npc.bow();
+			double reach = bow ? BOW_RANGE : REACH;
+			// Whom to deal with: of those in reach, whoever is hitting this NPC, else the nearest; failing that, face the nearest.
+			Mob victim = null;
+			double victimGap = Double.MAX_VALUE;
+			boolean victimAttacker = false;
+			for (Mob mob : threats) {
+				double gap = gap(npc, mob);
+				boolean attacker = mob.getTarget() == npc;
+				boolean inReach = gap < reach && Math.abs(mob.getY() - npc.getY()) < (bow ? 6.0 : npc.getBbHeight() + 0.5);
+				if (!inReach) {
+					continue;
+				}
+				if (victim == null || (attacker && !victimAttacker) || (attacker == victimAttacker && gap < victimGap)) {
+					victim = mob;
+					victimGap = gap;
+					victimAttacker = attacker;
+				}
+			}
+			Mob focus = victim != null ? victim : threats.getFirst();
+			if (now - stance.lastFaced >= FACE_EVERY) {
+				stance.lastFaced = now;
+				SkyLink.pushEvent(Proto.EV_NPC_STANCE, npc.formId(), (float) focus.getX(), (float) focus.getY(), (float) focus.getZ(), 1.0F, 0);
+			}
+			// A blow already swung lands now (a moment after the animation began, as it would in Skyrim).
+			if (stance.victim != null && now >= stance.landAt) {
+				if (stance.victim.isAlive()) {
+					var blow = level.damageSources().mobAttack(npc);
+					boolean hurt = npc.bow() ? stance.victim.hurtServer(level, blow, stance.damage) : NoShove.hurt(level, stance.victim, blow, stance.damage);
+					if (swingLogs++ < 60) {
+						SkyCraft.LOG.info("SkyCraft: NPC {} hit {} for {}: {}", String.format("%08X", npc.formId()), stance.victim.getName().getString(), stance.damage,
+							hurt ? "landed" : "refused");
+					}
+				}
+				stance.victim = null;
+			}
+			boolean out = npc.weaponDrawn() || now > stance.readyAt - DRAW_TICKS + STUCK_TICKS;
+			if (victim == null || !out || stance.victim != null || now < stance.readyAt || now < stance.nextSwing) {
+				continue; // weapon still coming out, or nothing in reach yet: the NPC waits for it, weapon out
+			}
+			SkyLink.pushEvent(Proto.EV_NPC_SWING, npc.formId(), (float) victim.getX(), (float) victim.getY(), (float) victim.getZ(), bow ? 1.0F : 0.0F, 0);
+			stance.victim = victim;
+			float base = Math.max(3.0F, npc.weaponDamage() * SKYRIM_TO_MC);
+			stance.damage = (bow ? base + 1.0F : base) + npc.getRandom().nextFloat() * 2.0F;
+			stance.landAt = now + (bow ? BOW_DELAY : MELEE_DELAY);
+			stance.nextSwing = now + (bow ? 45 : 16) + npc.getRandom().nextInt(8);
+		}
+		for (Iterator<Integer> it = STANCES.keySet().iterator(); it.hasNext(); ) {
+			if (!present.contains(it.next())) {
+				it.remove(); // gone from the world (died, or out of range)
+			}
+		}
+	}
+
+	private static double gap(SkyrimActorEntity npc, Mob mob) {
+		return Math.hypot(mob.getX() - npc.getX(), mob.getZ() - npc.getZ()) - npc.getBbWidth() * 0.5 - mob.getBbWidth() * 0.5;
+	}
+
+	/**
+	 * The hostile mobs this NPC has to deal with, the ones after it first and then by distance. A fighter
+	 * counts any hostile mob it can see or that is near; anyone else only a mob that is after it.
+	 */
+	private static List<Mob> threats(ServerLevel level, SkyrimActorEntity npc) {
+		boolean fighter = npc.fighter();
+		List<Mob> found = new ArrayList<>();
+		for (Mob mob : level.getEntitiesOfClass(Mob.class, npc.getBoundingBox().inflate(ALERT, 4.0, ALERT))) {
+			if (!mob.isAlive()) {
+				continue;
+			}
+			boolean after = mob.getTarget() == npc;
+			if (!after && mob.getType().getCategory() != MobCategory.MONSTER) {
+				continue;
+			}
+			double distance = Math.hypot(mob.getX() - npc.getX(), mob.getZ() - npc.getZ());
+			if (Math.abs(mob.getY() - npc.getY()) > npc.getBbHeight() + 3.0) {
+				continue;
+			}
+			if (after ? distance < SELF_DEFENCE * (fighter ? 2.5 : 1.0) : fighter && distance < ALERT && (distance < 8.0 || SkyrimMobs.canSee(npc, mob))) {
+				found.add(mob);
+			}
+		}
+		found.sort((a, b) -> {
+			boolean aa = a.getTarget() == npc, ba = b.getTarget() == npc;
+			if (aa != ba) {
+				return aa ? -1 : 1;
+			}
+			return Double.compare(a.distanceToSqr(npc), b.distanceToSqr(npc));
+		});
+		return found;
+	}
+}
