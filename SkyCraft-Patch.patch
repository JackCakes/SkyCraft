diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimChaseGoal.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimChaseGoal.java
new file mode 100644
index 0000000..0dacf42
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimChaseGoal.java
@@ -0,0 +1,162 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.SkyNav;
+import dev.skycraft.world.SkyTri;
+import java.util.List;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.goal.Goal;
+import net.minecraft.world.item.BowItem;
+import net.minecraft.world.item.CrossbowItem;
+
+/**
+ * A Minecraft mob with something to fight walks at it over Skyrim's ground, whoever it is (a player,
+ * one of Skyrim's NPCs). Minecraft's attack goals walk a mob by asking the pathfinder for a route, and
+ * it can't see Skyrim's land, so a mob after a player stood still until the player came into its reach.
+ * When Minecraft has no route of its own, this walks the mob at its target with the mob's own move
+ * control, over Skyrim's triangles and round what's in the way ({@link SkyNav}); the mob's attack
+ * goals do the rest once it's close. This goal holds no goal flags, so it never keeps those from running.
+ *
+ * <p>Turn it off with the JVM argument {@code -Dskycraft.mobsRoam=false}.
+ */
+public final class SkyrimChaseGoal extends Goal {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobsRoam"));
+	/** A target farther than this is left alone (Minecraft's own targeting gives up around here too). */
+	private static final double GIVE_UP = 40.0;
+	/** Archers stop walking at this distance if they can see the target, and shoot. */
+	private static final double SHOOT_FROM = 11.0;
+
+	private final Mob mob;
+	/** Minecraft's route is given up on when the mob has moved less than this (blocks) over {@link #STALL_CHECK_TICKS} ticks. */
+	private static final double STALL_DISTANCE = 0.3;
+	private static final int STALL_CHECK_TICKS = 20;
+	/** After giving up on Minecraft's route, this many ticks of walking by Skyrim's ground only, whatever the attack goals ask of the navigation. */
+	private static final int TAKEOVER_TICKS = 60;
+	/** Boxed in (every heading shut) this long, the mob jumps and shoves at its target rather than wait. */
+	private static final int BOXED_TICKS = 20;
+
+	private final SkyNav.Steer steer = new SkyNav.Steer(true);
+	private double[] wanted;
+	private double stallX = Double.NaN, stallZ;
+	private int stallTicks, takeover, boxed;
+
+	public SkyrimChaseGoal(Mob mob) {
+		this.mob = mob;
+	}
+
+	public static boolean wants(Mob mob) {
+		return ENABLED && SkyrimMobs.eligible(mob);
+	}
+
+	@Override
+	public boolean canUse() {
+		LivingEntity target = this.mob.getTarget();
+		return SkyLink.active() && this.mob.level() instanceof ServerLevel && target != null && target.isAlive() && !this.mob.isPassenger()
+			&& SkyrimMobs.walker(this.mob) && (this.mob.getNavigation().isDone() || this.takeover > 0 || this.stalled());
+	}
+
+	/**
+	 * Minecraft's pathfinder works on blocks, and on Skyrim's land it can still find a "route" (over blocks the player placed, say)
+	 * that the mob can't follow, and then it pushes at a hillside forever with this goal waiting for the route to finish. True when
+	 * the mob has a route and hasn't got anywhere for a second.
+	 */
+	private boolean stalled() {
+		double x = this.mob.getX(), z = this.mob.getZ();
+		if (Double.isNaN(this.stallX)) {
+			this.stallX = x;
+			this.stallZ = z;
+		}
+		if (++this.stallTicks < STALL_CHECK_TICKS) {
+			return false;
+		}
+		boolean stuck = Math.hypot(x - this.stallX, z - this.stallZ) < STALL_DISTANCE;
+		this.stallX = x;
+		this.stallZ = z;
+		this.stallTicks = 0;
+		if (stuck) {
+			this.takeover = TAKEOVER_TICKS;
+		}
+		return stuck;
+	}
+
+	@Override
+	public boolean canContinueToUse() {
+		LivingEntity target = this.mob.getTarget();
+		return SkyLink.active() && target != null && target.isAlive() && !this.mob.isPassenger() && this.mob.distanceToSqr(target) < GIVE_UP * GIVE_UP;
+	}
+
+	@Override
+	public void start() {
+		this.wanted = null;
+		this.boxed = 0;
+		this.steer.reset(this.mob.getRandom().nextBoolean());
+	}
+
+	@Override
+	public void stop() {
+		this.wanted = null;
+	}
+
+	// No @Override: not every version of Minecraft has this one (see SkyrimRoamGoal).
+	public boolean requiresUpdateEveryTick() {
+		return true;
+	}
+
+	@Override
+	public void tick() {
+		LivingEntity target = this.mob.getTarget();
+		if (target == null) {
+			return;
+		}
+		if (!this.mob.getNavigation().isDone()) {
+			if (this.takeover <= 0 && !this.stalled()) {
+				return; // Minecraft found a route of its own and is following it
+			}
+			this.mob.getNavigation().stop(); // it isn't getting anywhere on that route: Skyrim's ground takes over
+		}
+		if (this.takeover > 0) {
+			this.takeover--;
+		}
+		double distanceSqr = this.mob.distanceToSqr(target);
+		double closeEnough = this.mob.getBbWidth() * 1.2 + target.getBbWidth() * 0.5;
+		if (distanceSqr < closeEnough * closeEnough) {
+			return; // arrived: the mob's attack goals take over
+		}
+		var held = this.mob.getMainHandItem().getItem();
+		if ((held instanceof BowItem || held instanceof CrossbowItem) && distanceSqr < SHOOT_FROM * SHOOT_FROM && this.mob.getSensing().hasLineOfSight(target)) {
+			return; // archers keep their distance and shoot
+		}
+		if (!this.mob.onGround()) {
+			if (this.wanted != null) { // mid-jump or falling: carry on the way it was going
+				this.mob.getMoveControl().setWantedPosition(this.wanted[0], this.wanted[1], this.wanted[2], 1.0);
+			}
+			return;
+		}
+		List<SkyTri> tris = SkyrimMobs.trianglesAround(this.mob, SkyNav.REACH, SkyNav.BELOW, SkyNav.ABOVE);
+		double[] next = this.steer.next(
+			tris, SkyrimMobs.hazard(this.mob), this.mob.getX(), this.mob.getY(), this.mob.getZ(), this.mob.getBbWidth() * 0.5, this.mob.getBbHeight(),
+			this.mob.maxUpStep(), target.getX(), target.getZ()
+		);
+		if (next == null) {
+			// Boxed in (a cliff edge, a wall all round). It waits for the target to move, but not for ever: Skyrim's triangles can
+			// shut every way when the real ground would let it by (a lip a step too high, a gap in the mesh), so after a second it
+			// jumps and pushes at the target, and Minecraft's own movement and the collision settle what's really there.
+			if (++this.boxed >= BOXED_TICKS && distanceSqr < 12.0 * 12.0) {
+				this.boxed = 0;
+				this.mob.getJumpControl().jump();
+				this.mob.getMoveControl().setWantedPosition(target.getX(), target.getY(), target.getZ(), 1.0);
+				this.steer.reset(this.mob.getRandom().nextBoolean());
+			}
+			return;
+		}
+		this.boxed = 0;
+		if (this.steer.stuck()) { // steering but going nowhere: hop, and try the other way round
+			this.mob.getJumpControl().jump();
+			this.steer.reset(this.mob.getRandom().nextBoolean());
+		}
+		this.wanted = next;
+		this.mob.getMoveControl().setWantedPosition(next[0], next[1], next[2], 1.0);
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimMobs.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimMobs.java
new file mode 100644
index 0000000..8c9854c
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimMobs.java
@@ -0,0 +1,111 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.world.SkyCollision;
+import dev.skycraft.world.SkyNav;
+import dev.skycraft.world.SkyRay;
+import dev.skycraft.world.SkyTri;
+import dev.skycraft.world.SkyWater;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import net.minecraft.core.BlockPos;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.world.entity.LivingEntity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.control.MoveControl;
+import net.minecraft.world.level.Level;
+import net.minecraft.world.phys.AABB;
+
+/** What {@link SkyrimRoamGoal} and {@link SkyrimChaseGoal} share: which mobs they're for, and what a mob sees of Skyrim around it. */
+public final class SkyrimMobs {
+	/**
+	 * Mobs that don't walk the way a plain land mob does, or that run their own brain and walk
+	 * targets: left alone, they would fight what the goals ask of them.
+	 */
+	private static final Set<String> OWN_MOVEMENT = Set.of(
+		"villager", "piglin", "piglin_brute", "zoglin", "hoglin", "warden", "breeze", "creaking", "allay", "axolotl", "frog", "tadpole", "goat", "camel",
+		"camel_husk", "sniffer", "armadillo", "happy_ghast", "strider", "enderman", "shulker", "ender_dragon", "wither", "giant"
+	);
+
+	private SkyrimMobs() {
+	}
+
+	/** A mob the goals may help at all (the property {@code skycraft.mobsRoam=false} turns them off elsewhere). */
+	static boolean eligible(Mob mob) {
+		return !OWN_MOVEMENT.contains(BuiltInRegistries.ENTITY_TYPE.getKey(mob.getType()).getPath());
+	}
+
+	/**
+	 * Mobs that get about on foot with the plain move control: zombies, skeletons, spiders, creepers,
+	 * cows, pigs, sheep, wolves, horses. Flyers, swimmers, hoppers (slimes, rabbits) and the rest
+	 * have their own move control, which ours would only fight. A mob only has its final move control
+	 * once it's built, so this is asked when a goal runs, not when it's added.
+	 */
+	static boolean walker(Mob mob) {
+		return mob.getMoveControl().getClass() == MoveControl.class;
+	}
+
+	/** Skyrim's triangles around the mob: {@code reach} blocks sideways, {@code below} under its feet and {@code above} over its head. */
+	static List<SkyTri> trianglesAround(Mob mob, double reach, double below, double above) {
+		List<SkyTri> tris = new ArrayList<>();
+		SkyCollision.trianglesNear(
+			new AABB(mob.getX() - reach, mob.getY() - below, mob.getZ() - reach, mob.getX() + reach, mob.getY() + mob.getBbHeight() + above, mob.getZ() + reach), tris
+		);
+		return tris;
+	}
+
+	/** Water (Skyrim's, or Minecraft's, lava too) deep enough that a land mob shouldn't walk into it. */
+	static SkyNav.Hazard hazard(Mob mob) {
+		return (x, y, z) -> {
+			double surface = SkyWater.surfaceAt((int) Math.floor(x), (int) Math.floor(z));
+			if (!Double.isNaN(surface) && surface > y + 0.4) {
+				return true;
+			}
+			Level level = mob.level();
+			return !level.getFluidState(BlockPos.containing(x, y + 0.1, z)).isEmpty();
+		};
+	}
+
+	static boolean known(Mob mob) {
+		return SkyCollision.isKnown((int) Math.floor(mob.getX()), (int) Math.floor(mob.getY()), (int) Math.floor(mob.getZ()));
+	}
+
+	/** How far up {@link #covered} looks for a roof (Skyrim sends geometry about this far above the player). */
+	private static final double COVER_HEIGHT = 24.0;
+
+	/**
+	 * Whether {@code from} can see {@code to}: no Skyrim wall, hill or roof between their eyes.
+	 * Minecraft's own sight check only knows blocks, and there are none in Skyrim's land, so a mob
+	 * would see through every wall.
+	 */
+	static boolean canSee(LivingEntity from, LivingEntity to) {
+		double fx = from.getX(), fy = from.getEyeY(), fz = from.getZ();
+		double tx = to.getX(), ty = to.getY() + to.getBbHeight() * 0.85, tz = to.getZ();
+		List<SkyTri> tris = new ArrayList<>();
+		SkyCollision.trianglesNear(
+			new AABB(Math.min(fx, tx) - 0.5, Math.min(fy, ty) - 0.5, Math.min(fz, tz) - 0.5, Math.max(fx, tx) + 0.5, Math.max(fy, ty) + 0.5, Math.max(fz, tz) + 0.5), tris
+		);
+		return tris.isEmpty() || SkyRay.cast(tris, fx, fy, fz, tx, ty, tz) == null;
+	}
+
+	/** The same, from a living thing's eyes to a point. */
+	static boolean canSee(LivingEntity from, double tx, double ty, double tz) {
+		double fx = from.getX(), fy = from.getEyeY(), fz = from.getZ();
+		List<SkyTri> tris = new ArrayList<>();
+		SkyCollision.trianglesNear(
+			new AABB(Math.min(fx, tx) - 0.5, Math.min(fy, ty) - 0.5, Math.min(fz, tz) - 0.5, Math.max(fx, tx) + 0.5, Math.max(fy, ty) + 0.5, Math.max(fz, tz) + 0.5), tris
+		);
+		return tris.isEmpty() || SkyRay.cast(tris, fx, fy, fz, tx, ty, tz) == null;
+	}
+
+	/**
+	 * Skyrim geometry over a point: a roof, a cave ceiling, a tree. Minecraft sees the sky through all
+	 * of it (there are no blocks), so this is what tells "under cover" from "in the open".
+	 */
+	public static boolean covered(double x, double feetY, double z, double height) {
+		double from = feetY + height;
+		List<SkyTri> tris = new ArrayList<>();
+		SkyCollision.trianglesNear(new AABB(x - 0.3, from, z - 0.3, x + 0.3, from + COVER_HEIGHT, z + 0.3), tris);
+		return !tris.isEmpty() && SkyRay.cast(tris, x, from, z, x, from + COVER_HEIGHT, z) != null;
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimNoticeGoal.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimNoticeGoal.java
new file mode 100644
index 0000000..4227bc1
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimNoticeGoal.java
@@ -0,0 +1,89 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import java.util.List;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.entity.ai.goal.Goal;
+import java.util.EnumSet;
+
+/**
+ * A Minecraft mob that has noticed a Skyrim NPC looks at it, the way it looks at a player who comes
+ * near: a pig turns its head to follow whoever walks past, a zombie with nothing to fight eyes
+ * the nearest passer-by. Minecraft's own look-at-player goal only knows players (and doesn't
+ * consider an invisible stand-in), so this is the same thing for Skyrim's NPCs: within a few blocks,
+ * in sight, now and then, for two to four seconds at a time.
+ *
+ * <p>Turn it off with the JVM argument {@code -Dskycraft.mobsNoticeNpcs=false}.
+ */
+public final class SkyrimNoticeGoal extends Goal {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobsNoticeNpcs"));
+	/** Minecraft's chance per tick that an idle mob takes notice of someone within range. */
+	private static final float CHANCE = 0.02F;
+
+	private final Mob mob;
+	private final double range;
+	private SkyrimActorEntity watched;
+	private int lookTime;
+
+	public SkyrimNoticeGoal(Mob mob) {
+		this.mob = mob;
+		// Minecraft's monsters look from 8 blocks, its animals from 6.
+		this.range = mob.getType().getCategory() == MobCategory.MONSTER ? 8.0 : 6.0;
+		this.setFlags(EnumSet.of(Goal.Flag.LOOK));
+	}
+
+	public static boolean wants(Mob mob) {
+		MobCategory category = mob.getType().getCategory();
+		return ENABLED && (category == MobCategory.MONSTER || category == MobCategory.CREATURE);
+	}
+
+	@Override
+	public boolean canUse() {
+		if (!SkyLink.active() || !(this.mob.level() instanceof ServerLevel) || this.mob.getTarget() != null || this.mob.getRandom().nextFloat() >= CHANCE) {
+			return false;
+		}
+		List<SkyrimActorEntity> near = this.mob.level().getEntitiesOfClass(SkyrimActorEntity.class, this.mob.getBoundingBox().inflate(this.range, 3.0, this.range));
+		SkyrimActorEntity best = null;
+		double bestDistance = this.range * this.range;
+		for (SkyrimActorEntity actor : near) {
+			double distance = this.mob.distanceToSqr(actor);
+			if (actor.isAlive() && distance < bestDistance && SkyrimMobs.canSee(this.mob, actor)) {
+				best = actor;
+				bestDistance = distance;
+			}
+		}
+		this.watched = best;
+		return best != null;
+	}
+
+	@Override
+	public boolean canContinueToUse() {
+		return this.watched != null && this.watched.isAlive() && !this.watched.isRemoved() && this.mob.getTarget() == null && this.lookTime > 0
+			&& this.mob.distanceToSqr(this.watched) <= this.range * this.range;
+	}
+
+	@Override
+	public void start() {
+		this.lookTime = 40 + this.mob.getRandom().nextInt(40);
+	}
+
+	@Override
+	public void stop() {
+		this.watched = null;
+	}
+
+	// No @Override: not every version of Minecraft has this one (see SkyrimRoamGoal).
+	public boolean requiresUpdateEveryTick() {
+		return true;
+	}
+
+	@Override
+	public void tick() {
+		if (this.watched != null) {
+			this.mob.getLookControl().setLookAt(this.watched.getX(), this.watched.getEyeY(), this.watched.getZ());
+			this.lookTime--;
+		}
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimPanicGoal.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimPanicGoal.java
new file mode 100644
index 0000000..415668a
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimPanicGoal.java
@@ -0,0 +1,151 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.SkyNav;
+import dev.skycraft.world.SkyTri;
+import java.util.EnumSet;
+import java.util.List;
+import java.util.Set;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.damagesource.DamageSource;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.ai.goal.Goal;
+
+/**
+ * Minecraft's farm animals run when they are hit: pigs, sheep, cows, chickens and horses bolt for a few
+ * seconds, away from whatever struck them. Minecraft's own panic picks a spot and asks the pathfinder for
+ * a way there, which can't see Skyrim's land, so on Skyrim's ground they just stood and took it. This does
+ * the same thing the way {@link SkyrimRoamGoal} walks: it picks a spot away from the attacker that the mob
+ * can reach over Skyrim's triangles and goes there with the mob's own move control, faster than a stroll.
+ *
+ * <p>Turn it off with the JVM argument {@code -Dskycraft.mobsPanic=false}.
+ */
+public final class SkyrimPanicGoal extends Goal {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobsPanic"));
+	/** The animals whose Minecraft brain has a panic goal. (Wolves, bees and the like fight back instead.) */
+	private static final Set<String> PANICS = Set.of("chicken", "cow", "mooshroom", "pig", "sheep", "horse", "donkey", "mule");
+	private static final double MIN_DISTANCE = 5.0;
+	private static final double MAX_DISTANCE = 9.0;
+	private static final int TRIES = 10;
+	private static final int MAX_TICKS = 100;
+	private static final double ARRIVED = 0.8;
+
+	private final Mob mob;
+	private final SkyNav.Steer steer = new SkyNav.Steer(true);
+	private double goalX, goalZ;
+	private int ticks;
+	private boolean finished;
+	private double[] wanted;
+	private double speed = 1.25;
+
+	public SkyrimPanicGoal(Mob mob) {
+		this.mob = mob;
+		this.setFlags(EnumSet.of(Goal.Flag.MOVE));
+	}
+
+	public static boolean wants(Mob mob) {
+		return ENABLED && SkyrimMobs.eligible(mob) && PANICS.contains(BuiltInRegistries.ENTITY_TYPE.getKey(mob.getType()).getPath());
+	}
+
+	/** The thing that just hit the mob, if something did (Minecraft forgets the last blow after two seconds). */
+	private Entity attacker() {
+		DamageSource source = this.mob.getLastDamageSource();
+		return source == null ? null : source.getEntity();
+	}
+
+	@Override
+	public boolean canUse() {
+		if (!SkyLink.active() || !(this.mob.level() instanceof ServerLevel) || this.mob.isPassenger() || !this.mob.onGround() || this.mob.isInWater()
+			|| !SkyrimMobs.walker(this.mob) || !SkyrimMobs.known(this.mob)) {
+			return false;
+		}
+		Entity attacker = attacker();
+		return attacker != null && attacker != this.mob && choose(attacker);
+	}
+
+	private boolean choose(Entity attacker) {
+		double x = this.mob.getX(), y = this.mob.getY(), z = this.mob.getZ();
+		double awayX = x - attacker.getX(), awayZ = z - attacker.getZ();
+		double length = Math.hypot(awayX, awayZ);
+		double away = length > 1.0E-4 ? Math.atan2(awayZ, awayX) : this.mob.getRandom().nextDouble() * (Math.PI * 2.0);
+		List<SkyTri> tris = SkyrimMobs.trianglesAround(this.mob, MAX_DISTANCE + 1.5, SkyNav.BELOW + 3.0, SkyNav.ABOVE + 3.0);
+		if (tris.isEmpty()) {
+			return false;
+		}
+		var hazard = SkyrimMobs.hazard(this.mob);
+		var random = this.mob.getRandom();
+		double radius = this.mob.getBbWidth() * 0.5, height = this.mob.getBbHeight(), stepUp = this.mob.maxUpStep();
+		for (int i = 0; i < TRIES; i++) {
+			// Straight away from the attacker first, then fanning out when something is in the way.
+			double spread = (Math.PI / 3.0) * (1.0 + i / 4.0);
+			double angle = away + (random.nextDouble() * 2.0 - 1.0) * spread;
+			double distance = MIN_DISTANCE + random.nextDouble() * (MAX_DISTANCE - MIN_DISTANCE);
+			double tx = x + Math.cos(angle) * distance, tz = z + Math.sin(angle) * distance;
+			if (SkyNav.canWalk(tris, hazard, x, y, z, radius, height, stepUp, tx, tz)) {
+				this.goalX = tx;
+				this.goalZ = tz;
+				return true;
+			}
+		}
+		return false;
+	}
+
+	@Override
+	public boolean canContinueToUse() {
+		return !this.finished && this.ticks < MAX_TICKS && SkyLink.active() && !this.mob.isPassenger() && this.mob.isAlive();
+	}
+
+	@Override
+	public void start() {
+		this.ticks = 0;
+		this.finished = false;
+		this.wanted = null;
+		this.steer.reset(this.mob.getRandom().nextBoolean());
+		String type = BuiltInRegistries.ENTITY_TYPE.getKey(this.mob.getType()).getPath();
+		this.speed = type.equals("cow") || type.equals("mooshroom") ? 2.0 : type.equals("chicken") ? 1.4 : 1.25;
+	}
+
+	@Override
+	public void stop() {
+		this.wanted = null;
+	}
+
+	// No @Override: not every version of Minecraft has this one (see SkyrimRoamGoal).
+	public boolean requiresUpdateEveryTick() {
+		return true;
+	}
+
+	@Override
+	public void tick() {
+		this.ticks++;
+		double x = this.mob.getX(), y = this.mob.getY(), z = this.mob.getZ();
+		if (Math.hypot(this.goalX - x, this.goalZ - z) < ARRIVED) {
+			// Got there: still being chased (hit again a moment ago)? Pick another spot further on.
+			Entity attacker = attacker();
+			if (attacker != null && attacker != this.mob && this.ticks < MAX_TICKS - 20 && this.mob.onGround() && choose(attacker)) {
+				this.steer.reset(this.mob.getRandom().nextBoolean());
+				return;
+			}
+			this.finished = true;
+			return;
+		}
+		if (!this.mob.onGround()) {
+			if (this.wanted != null) { // mid-jump or falling: carry on the way it was going
+				this.mob.getMoveControl().setWantedPosition(this.wanted[0], this.wanted[1], this.wanted[2], this.speed);
+			}
+			return;
+		}
+		List<SkyTri> tris = SkyrimMobs.trianglesAround(this.mob, SkyNav.REACH, SkyNav.BELOW, SkyNav.ABOVE);
+		double[] next = this.steer.next(
+			tris, SkyrimMobs.hazard(this.mob), x, y, z, this.mob.getBbWidth() * 0.5, this.mob.getBbHeight(), this.mob.maxUpStep(), this.goalX, this.goalZ
+		);
+		if (next == null || this.steer.stuck()) {
+			this.finished = true;
+			return;
+		}
+		this.wanted = next;
+		this.mob.getMoveControl().setWantedPosition(next[0], next[1], next[2], this.speed);
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimRoamGoal.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimRoamGoal.java
new file mode 100644
index 0000000..c0fe73b
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimRoamGoal.java
@@ -0,0 +1,137 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.SkyNav;
+import dev.skycraft.world.SkyTri;
+import java.util.EnumSet;
+import java.util.List;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.entity.ai.goal.Goal;
+
+/**
+ * Minecraft mobs wander about on Skyrim's ground as they would on Minecraft's. Minecraft's own
+ * strolling picks a spot and asks the pathfinder for a way there, which can't see Skyrim's land, so
+ * mobs stood where they spawned. This picks a spot a few blocks off that the mob can walk to in a
+ * straight line over Skyrim's triangles (no wall, cliff or deep water on the way, ledges it can jump
+ * allowed), and walks there with the mob's own move control, going round what's in the way ({@link SkyNav}).
+ * About every six seconds an idle mob sets off, like Minecraft's.
+ *
+ * <p>Turn it off with the JVM argument {@code -Dskycraft.mobsRoam=false}.
+ */
+public final class SkyrimRoamGoal extends Goal {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobsRoam"));
+	private static final double MIN_DISTANCE = 3.0;
+	private static final double MAX_DISTANCE = 8.0;
+	private static final int TRIES = 8;
+	private static final int MAX_TICKS = 400;
+	private static final double ARRIVED = 0.8;
+
+	private final Mob mob;
+	private final SkyNav.Steer steer = new SkyNav.Steer(true);
+	private double goalX, goalZ;
+	private int ticks;
+	private boolean finished;
+	private double[] wanted;
+
+	public SkyrimRoamGoal(Mob mob) {
+		this.mob = mob;
+		this.setFlags(EnumSet.of(Goal.Flag.MOVE));
+	}
+
+	/** Land animals and monsters. */
+	public static boolean wants(Mob mob) {
+		if (!ENABLED || !SkyrimMobs.eligible(mob)) {
+			return false;
+		}
+		MobCategory category = mob.getType().getCategory();
+		return category == MobCategory.MONSTER || category == MobCategory.CREATURE;
+	}
+
+	@Override
+	public boolean canUse() {
+		if (!SkyLink.active() || !(this.mob.level() instanceof ServerLevel) || this.mob.getTarget() != null || this.mob.isPassenger() || !this.mob.onGround()
+			|| this.mob.isInWater() || !this.mob.getNavigation().isDone() || this.mob.getRandom().nextInt(60) != 0 || !SkyrimMobs.walker(this.mob)) {
+			return false;
+		}
+		return choose();
+	}
+
+	/** A spot the mob can walk to, if one of a few tries finds it. */
+	private boolean choose() {
+		if (!SkyrimMobs.known(this.mob)) {
+			return false;
+		}
+		double x = this.mob.getX(), y = this.mob.getY(), z = this.mob.getZ();
+		List<SkyTri> tris = SkyrimMobs.trianglesAround(this.mob, MAX_DISTANCE + 1.5, SkyNav.BELOW + 3.0, SkyNav.ABOVE + 3.0);
+		if (tris.isEmpty()) {
+			return false;
+		}
+		var hazard = SkyrimMobs.hazard(this.mob);
+		var random = this.mob.getRandom();
+		double radius = this.mob.getBbWidth() * 0.5, height = this.mob.getBbHeight(), stepUp = this.mob.maxUpStep();
+		for (int i = 0; i < TRIES; i++) {
+			double angle = random.nextDouble() * (Math.PI * 2.0);
+			double distance = MIN_DISTANCE + random.nextDouble() * (MAX_DISTANCE - MIN_DISTANCE);
+			double tx = x + Math.cos(angle) * distance, tz = z + Math.sin(angle) * distance;
+			if (SkyNav.canWalk(tris, hazard, x, y, z, radius, height, stepUp, tx, tz)) {
+				this.goalX = tx;
+				this.goalZ = tz;
+				return true;
+			}
+		}
+		return false;
+	}
+
+	@Override
+	public boolean canContinueToUse() {
+		return !this.finished && this.ticks < MAX_TICKS && SkyLink.active() && this.mob.getTarget() == null && !this.mob.isPassenger()
+			&& this.mob.getNavigation().isDone();
+	}
+
+	@Override
+	public void start() {
+		this.ticks = 0;
+		this.finished = false;
+		this.wanted = null;
+		this.steer.reset(this.mob.getRandom().nextBoolean());
+	}
+
+	@Override
+	public void stop() {
+		this.wanted = null;
+	}
+
+	// No @Override: not every version of Minecraft has this one. Minecraft's move control walks one
+	// tick per order, so without it the mob would only move every other tick.
+	public boolean requiresUpdateEveryTick() {
+		return true;
+	}
+
+	@Override
+	public void tick() {
+		this.ticks++;
+		double x = this.mob.getX(), y = this.mob.getY(), z = this.mob.getZ();
+		if (Math.hypot(this.goalX - x, this.goalZ - z) < ARRIVED) {
+			this.finished = true;
+			return;
+		}
+		if (!this.mob.onGround()) {
+			if (this.wanted != null) { // mid-jump or falling: carry on the way it was going
+				this.mob.getMoveControl().setWantedPosition(this.wanted[0], this.wanted[1], this.wanted[2], 1.0);
+			}
+			return;
+		}
+		List<SkyTri> tris = SkyrimMobs.trianglesAround(this.mob, SkyNav.REACH, SkyNav.BELOW, SkyNav.ABOVE);
+		double[] next = this.steer.next(
+			tris, SkyrimMobs.hazard(this.mob), x, y, z, this.mob.getBbWidth() * 0.5, this.mob.getBbHeight(), this.mob.maxUpStep(), this.goalX, this.goalZ
+		);
+		if (next == null || this.steer.stuck()) {
+			this.finished = true; // no way on from here, or going nowhere: it'll pick another spot later
+			return;
+		}
+		this.wanted = next;
+		this.mob.getMoveControl().setWantedPosition(next[0], next[1], next[2], 1.0);
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimSpawner.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimSpawner.java
new file mode 100644
index 0000000..9f18d6b
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimSpawner.java
@@ -0,0 +1,319 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.link.SkyLink;
+import dev.skycraft.world.SkyCollision;
+import dev.skycraft.world.SkyRay;
+import dev.skycraft.world.SkyTime;
+import dev.skycraft.world.SkyTri;
+import dev.skycraft.world.SkyWater;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import net.fabricmc.fabric.api.event.lifecycle.v1.ServerTickEvents;
+import net.minecraft.core.registries.BuiltInRegistries;
+import net.minecraft.resources.Identifier;
+import net.minecraft.server.MinecraftServer;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.util.RandomSource;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntitySpawnReason;
+import net.minecraft.world.entity.EntityType;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.entity.MobCategory;
+import net.minecraft.world.entity.SpawnGroupData;
+import net.minecraft.world.phys.AABB;
+
+/**
+ * Minecraft's mobs spawn in Skyrim's world the way they do in Minecraft. Minecraft's own spawner
+ * looks for solid blocks to stand on and finds none (Skyrim's land isn't made of blocks), so this
+ * does what it does over Skyrim's ground instead:
+ *
+ * <ul>
+ * <li>Hostile mobs (zombies, skeletons, spiders, creepers) spawn in packs, 24 to 38 blocks from the
+ * player, where it is dark: on open ground at night (Skyrim's night, see {@link SkyTime}) and under
+ * cover (caves, ruins, any roof) at any hour. Under cover they don't burn in the sun.
+ * <li>Animals (sheep, pigs, chickens, cows, horses) spawn in packs on Skyrim's open land by day.
+ * <li>Neither spawns on water, in a spot the player has no line of sight to (it might be on the far
+ * side of a wall or on a roof), or near Skyrim's NPCs (towns and their houses are lit and lived in).
+ * <li>Like Minecraft's, each kind has a cap on how many live around the player, and mobs left far
+ * behind are removed (Skyrim only sends the land near the player, and a mob past it would fall).
+ * </ul>
+ *
+ * <p>Only mobs this spawned are counted and removed. Turn it off with the JVM argument
+ * {@code -Dskycraft.mobSpawning=false}; {@code -Dskycraft.monsterCap=N} and {@code -Dskycraft.animalCap=N}
+ * change the caps (Minecraft's 70 and 10 are for an area some thirty times bigger than Skyrim's land here).
+ */
+public final class SkyrimSpawner {
+	private static final boolean ENABLED = !"false".equalsIgnoreCase(System.getProperty("skycraft.mobSpawning"));
+	private static final int MONSTER_CAP = Integer.getInteger("skycraft.monsterCap", 8);
+	private static final int ANIMAL_CAP = Integer.getInteger("skycraft.animalCap", 6);
+	private static final String TAG = "skycraft_natural";
+
+	private static final int MONSTER_EVERY = 20;
+	private static final int ANIMAL_EVERY = 60;
+	private static final int UPKEEP_EVERY = 10;
+	private static final double MIN_DISTANCE = 24.0;
+	private static final double ANIMAL_MIN_DISTANCE = 16.0;
+	private static final double MAX_DISTANCE = 38.0;
+	/** Farther than this from every player, a spawned mob is removed. */
+	private static final double DESPAWN_DISTANCE = 52.0;
+	/** Where a spot's ground is looked for: this far above and below the player. */
+	private static final double ABOVE = 8.0;
+	private static final double CEILING_REACH = 3.5;
+	private static final double BELOW = 16.0;
+	private static final double NPC_BUFFER = 16.0;
+	/** No mob spawns within this many blocks of a friendly person (a village is that wide, and a mob spawns 24 or more blocks from the player). */
+	private static final double PEOPLE_BUFFER = 45.0;
+
+	private record Kind(String id, int weight, int min, int max) {
+	}
+
+	// Minecraft's overworld spawn lists (weights and pack sizes).
+	private static final List<Kind> MONSTERS = List.of(
+		new Kind("spider", 100, 4, 4), new Kind("zombie", 95, 4, 4), new Kind("zombie_villager", 5, 1, 1),
+		new Kind("skeleton", 100, 4, 4), new Kind("creeper", 100, 4, 4)
+	);
+	private static final List<Kind> ANIMALS = List.of(
+		new Kind("sheep", 12, 2, 4), new Kind("pig", 10, 2, 4), new Kind("chicken", 10, 4, 4),
+		new Kind("cow", 8, 2, 4), new Kind("horse", 5, 2, 6), new Kind("donkey", 1, 1, 3)
+	);
+
+	private static final Map<String, EntityType<?>> RESOLVED = new HashMap<>();
+
+	/** The entity type for a spawn-list name, looked up in the registry (null if this Minecraft has none by that name). */
+	@SuppressWarnings("unchecked")
+	private static EntityType<? extends Mob> typeOf(Kind kind) {
+		return (EntityType<? extends Mob>) RESOLVED.computeIfAbsent(
+			kind.id(), id -> BuiltInRegistries.ENTITY_TYPE.getOptional(Identifier.withDefaultNamespace(id)).orElse(null)
+		);
+	}
+
+	// Monsters standing under Skyrim's roofs: Minecraft would burn them in daylight, there being no blocks over them.
+	private static final List<Mob> SHADED = new ArrayList<>();
+
+	// Why spots were turned down, and how many mobs went in, reported to the log every half minute.
+	private static final Map<String, Integer> REJECTS = new HashMap<>();
+	private static int spawned, attempts;
+	private static boolean waitingLogged;
+
+	private static double[] reject(String why) {
+		REJECTS.merge(why, 1, Integer::sum);
+		return null;
+	}
+
+	private SkyrimSpawner() {
+	}
+
+	public static void init() {
+		ServerTickEvents.END_SERVER_TICK.register(SkyrimSpawner::tick);
+	}
+
+	private static void tick(MinecraftServer server) {
+		for (int i = SHADED.size() - 1; i >= 0; i--) {
+			Mob mob = SHADED.get(i);
+			if (!mob.isAlive()) {
+				SHADED.remove(i);
+			} else if (mob.isOnFire() && !mob.isInLava()) {
+				mob.setRemainingFireTicks(0); // every tick, so it never gets to take the burn damage
+			}
+		}
+		if (!SkyLink.active() || !SkyTime.known()) {
+			if (SkyLink.active() && !waitingLogged && server.getTickCount() % 200 == 0) {
+				waitingLogged = true;
+				dev.skycraft.SkyCraft.LOG.info("SkyCraft spawner: waiting for Skyrim's clock (SkyTime isn't live yet)");
+			}
+			return;
+		}
+		int ticks = server.getTickCount();
+		if (ticks % 600 == 0) {
+			dev.skycraft.SkyCraft.LOG.info("SkyCraft spawner: hour {}, {} attempts, {} mobs spawned, turned-down spots: {}", SkyTime.hour(), attempts, spawned, REJECTS);
+			REJECTS.clear();
+			attempts = 0;
+		}
+		boolean upkeep = ticks % UPKEEP_EVERY == 0;
+		if (upkeep) {
+			SHADED.clear();
+		}
+		for (ServerPlayer player : server.getPlayerList().getPlayers()) {
+			if (!player.isAlive() || player.isSpectator()) {
+				continue;
+			}
+			ServerLevel level = player.level();
+			if (upkeep) {
+				upkeep(level, player);
+			}
+			if (ENABLED && ticks % MONSTER_EVERY == 0) {
+				attempt(level, player, true);
+			}
+			if (ENABLED && ticks % ANIMAL_EVERY == 0) {
+				attempt(level, player, false);
+			}
+		}
+	}
+
+	/** Takes mobs that have been left behind out of the world, and notes which monsters are under cover. */
+	private static void upkeep(ServerLevel level, ServerPlayer player) {
+		AABB around = player.getBoundingBox().inflate(DESPAWN_DISTANCE + 8.0, 64.0, DESPAWN_DISTANCE + 8.0);
+		for (Mob mob : level.getEntitiesOfClass(Mob.class, around)) {
+			if (mob.entityTags().contains(TAG)) {
+				boolean far = level.getNearestPlayer(mob, DESPAWN_DISTANCE) == null;
+				if (far || !SkyrimMobs.known(mob)) {
+					mob.discard();
+					continue;
+				}
+			}
+			if (mob.getType().getCategory() == MobCategory.MONSTER && !mob.fireImmune()
+				&& SkyrimMobs.covered(mob.getX(), mob.getY(), mob.getZ(), mob.getBbHeight())) {
+				SHADED.add(mob);
+			}
+		}
+	}
+
+	private static void attempt(ServerLevel level, ServerPlayer player, boolean monsters) {
+		// Not where people live: in a town, city, village, farm or inn nothing spawns, whatever the hour.
+		if (SkyTime.inSettlement()) {
+			REJECTS.merge("player is in a settlement", 1, Integer::sum);
+			return;
+		}
+		int cap = monsters ? MONSTER_CAP : ANIMAL_CAP;
+		MobCategory category = monsters ? MobCategory.MONSTER : MobCategory.CREATURE;
+		int living = level.getEntitiesOfClass(
+			Mob.class, player.getBoundingBox().inflate(DESPAWN_DISTANCE, 64.0, DESPAWN_DISTANCE),
+			mob -> mob.getType().getCategory() == category && mob.entityTags().contains(TAG)
+		).size();
+		if (living >= cap) {
+			return;
+		}
+		RandomSource random = level.getRandom();
+		Kind kind = pick(monsters ? MONSTERS : ANIMALS, random);
+		EntityType<? extends Mob> type = typeOf(kind);
+		if (type == null) {
+			return;
+		}
+		attempts++;
+		for (int tries = 0; tries < 10; tries++) {
+			double angle = random.nextDouble() * (Math.PI * 2.0);
+			double distance = (monsters ? MIN_DISTANCE : ANIMAL_MIN_DISTANCE) + random.nextDouble() * (MAX_DISTANCE - (monsters ? MIN_DISTANCE : ANIMAL_MIN_DISTANCE));
+			double[] spot = findSpot(level, player, player.getX() + Math.cos(angle) * distance, player.getZ() + Math.sin(angle) * distance, type.getHeight(), monsters);
+			if (spot == null) {
+				continue;
+			}
+			int size = kind.min() + (kind.max() > kind.min() ? random.nextInt(kind.max() - kind.min() + 1) : 0);
+			SpawnGroupData group = null;
+			int placed = 0;
+			for (int i = 0; i < size && living + placed < cap; i++) {
+				double[] at = i == 0 ? spot : findSpot(level, player, spot[0] + (random.nextDouble() - 0.5) * 8.0, spot[2] + (random.nextDouble() - 0.5) * 8.0, type.getHeight(), monsters);
+				if (at == null) {
+					continue;
+				}
+				Entity made = type.create(level, EntitySpawnReason.NATURAL);
+				if (!(made instanceof Mob mob)) {
+					continue;
+				}
+				mob.snapTo(at[0], at[1], at[2], random.nextFloat() * 360.0F, 0.0F);
+				// Standing exactly on Skyrim's surface can clip its voxelised collision; start a little
+				// higher if so and let the mob drop onto the ground.
+				boolean room = level.noCollision(mob);
+				for (double lift : new double[] { 0.15, 0.35, 0.7 }) {
+					if (room) {
+						break;
+					}
+					mob.snapTo(at[0], at[1] + lift, at[2], mob.getYRot(), 0.0F);
+					room = level.noCollision(mob);
+				}
+				if (!room) {
+					REJECTS.merge("no room for the mob", 1, Integer::sum);
+					mob.discard();
+					continue;
+				}
+				// Something under its feet within a block and a half, or it would appear in mid-air.
+				if (!mob.isNoGravity() && level.noCollision(mob, mob.getBoundingBox().expandTowards(0.0, -1.5, 0.0))) {
+					REJECTS.merge("nothing under its feet", 1, Integer::sum);
+					mob.discard();
+					continue;
+				}
+				mob.addTag(TAG);
+				mob.setPersistenceRequired(); // Minecraft's own despawning would thin them out; upkeep() handles distance
+				group = mob.finalizeSpawn(level, level.getCurrentDifficultyAt(mob.blockPosition()), EntitySpawnReason.NATURAL, group);
+				level.addFreshEntityWithPassengers(mob);
+				if (!mob.isRemoved()) {
+					placed++;
+					spawned++;
+				}
+			}
+			if (placed > 0) {
+				return;
+			}
+		}
+	}
+
+	private static Kind pick(List<Kind> kinds, RandomSource random) {
+		int total = 0;
+		for (Kind kind : kinds) {
+			total += kind.weight();
+		}
+		int roll = random.nextInt(total);
+		for (Kind kind : kinds) {
+			roll -= kind.weight();
+			if (roll < 0) {
+				return kind;
+			}
+		}
+		return kinds.getFirst();
+	}
+
+	/** Ground to stand on at (x, z), if a mob of this kind may spawn there: {x, feet y, z}. */
+	private static double[] findSpot(ServerLevel level, ServerPlayer player, double x, double z, float height, boolean monster) {
+		int bx = (int) Math.floor(x), bz = (int) Math.floor(z);
+		if (!SkyCollision.isKnown(bx, (int) Math.floor(player.getY()), bz)) {
+			return reject("geometry not sent there");
+		}
+		// The ground is looked for from a little above the player's head down, not from far above: a roof, cave ceiling or
+		// treetop higher up is not somewhere a mob can stand (and Skyrim's one-sided surfaces would read as floor from above).
+		double top = player.getY() + CEILING_REACH, bottom = player.getY() - BELOW;
+		List<SkyTri> tris = new ArrayList<>();
+		SkyCollision.trianglesNear(new AABB(x - 1.0, bottom, z - 1.0, x + 1.0, top, z + 1.0), tris);
+		SkyRay.Hit ground = tris.isEmpty() ? null : SkyRay.cast(tris, x, top, z, x, bottom, z);
+		if (ground == null) {
+			return reject("no ground found");
+		}
+		if (ground.ny() < SkyTri.WALKABLE_NY || !ground.tri().walkable) {
+			return reject("too steep / roof above");
+		}
+		double y = ground.y();
+		// Under a roof of its own (a cave, a building) the player stands on a floor; never on what is above it.
+		if (y > player.getY() + 2.0 && SkyrimMobs.covered(player.getX(), player.getY(), player.getZ(), 1.8F)) {
+			return reject("above a covered player");
+		}
+		double surface = SkyWater.surfaceAt(bx, bz);
+		if (!Double.isNaN(surface) && surface > y - 0.2) {
+			return reject("water");
+		}
+		boolean covered = SkyrimMobs.covered(x, y, z, height);
+		if (monster ? !(SkyTime.isNight() || covered) : (covered || !SkyTime.isDay() || !ground.tri().terrain)) {
+			return reject(monster ? "monster: open ground by day" : "animal: night / covered / not terrain");
+		}
+		// Room for the mob, and a spot the player could walk or look to, not the far side of a wall or the top of a roof.
+		List<SkyTri> room = new ArrayList<>();
+		SkyCollision.trianglesNear(new AABB(x - 0.4, y + 0.1, z - 0.4, x + 0.4, y + height, z + 0.4), room);
+		if (!room.isEmpty() && SkyRay.cast(room, x, y + 0.1, z, x, y + height, z) != null) {
+			return reject("blocked headroom");
+		}
+		if (!SkyrimMobs.canSee(player, x, y + height, z)) {
+			return reject("out of player's sight");
+		}
+		AABB nearNpcs = new AABB(x - NPC_BUFFER, y - 8.0, z - NPC_BUFFER, x + NPC_BUFFER, y + 8.0, z + NPC_BUFFER);
+		if (!level.getEntitiesOfClass(SkyrimActorEntity.class, nearNpcs, npc -> npc.isAlive()).isEmpty()) {
+			return reject("near NPCs");
+		}
+		// Anywhere people are going about their day (a town's streets, a farmstead, a camp, an inn's yard), not only right beside them.
+		// Skyrim's NPCs are known out to 80 blocks, so a settlement the player stands outside of (its gate in sight) is still seen.
+		AABB peopleAround = new AABB(x - PEOPLE_BUFFER, y - 16.0, z - PEOPLE_BUFFER, x + PEOPLE_BUFFER, y + 16.0, z + PEOPLE_BUFFER);
+		if (!level.getEntitiesOfClass(SkyrimActorEntity.class, peopleAround, npc -> npc.isAlive() && npc.person() && !npc.hostileToPlayer()).isEmpty()) {
+			return reject("friendly people nearby (a settlement)");
+		}
+		return new double[] { x, y, z };
+	}
+}
diff --git a/fabric/src/main/java/dev/skycraft/combat/SkyrimSwings.java b/fabric/src/main/java/dev/skycraft/combat/SkyrimSwings.java
new file mode 100644
index 0000000..7cd4df6
--- /dev/null
+++ b/fabric/src/main/java/dev/skycraft/combat/SkyrimSwings.java
@@ -0,0 +1,151 @@
+package dev.skycraft.combat;
+
+import dev.skycraft.SkyCraft;
+import dev.skycraft.link.Proto;
+import dev.skycraft.world.SkyClip;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Optional;
+import net.minecraft.server.level.ServerLevel;
+import net.minecraft.server.level.ServerPlayer;
+import net.minecraft.world.entity.Mob;
+import net.minecraft.world.phys.AABB;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * The player hits Minecraft's mobs with Skyrim's own weapons, in Skyrim's control mode. There Skyrim
+ * swings the sword, draws the bow and moves the camera, and Minecraft's player only rides along, so
+ * Minecraft never sees an attack. Skyrim tells it when its player swings or shoots
+ * ({@link Proto#IN_SWING}: what kind, how hard by Skyrim's reckoning, and where the player faces) and the
+ * mobs in the way take the hit through Minecraft's own damage, so armour, knockback, hurt sounds and
+ * death work as they do for any hit of the player's.
+ *
+ * <ul>
+ * <li>A melee swing hits the nearest mob in front of the player within arm's reach; a power attack
+ * hits up to three. Skyrim's walls and hills stop a blow as they would a player's eyes.
+ * <li>A bow or crossbow shot is traced along the way the player faces, since Skyrim's arrow flies in
+ * Skyrim and never meets a Minecraft mob: the first mob on the line, in the open, takes it, harder the
+ * further the bow was drawn.
+ * </ul>
+ */
+public final class SkyrimSwings {
+	/** Skyrim weapon damage -> Minecraft damage for a hit on a mob (an iron sword's 7 is near Minecraft's 6). */
+	private static final float SKYRIM_TO_MC = 0.8F;
+	private static final double MELEE_REACH = 3.4;
+	/** The mob must be within this cosine of the way the player faces (about 63 degrees either side). */
+	private static final double MELEE_CONE = 0.45;
+	private static final double ARROW_RANGE = 40.0;
+
+	private SkyrimSwings() {
+	}
+
+	/** Runs on the server thread. {@code yaw} and {@code pitch} are Minecraft's, in degrees; {@code charge} 0 to 1. */
+	public static void swing(ServerPlayer player, int kind, float skyrimDamage, float yaw, float pitch, float charge) {
+		if (!player.isAlive() || player.isSpectator() || skyrimDamage <= 0.0F) {
+			return;
+		}
+		ServerLevel level = player.level();
+		double yawRad = Math.toRadians(yaw), pitchRad = Math.toRadians(pitch);
+		Vec3 look = new Vec3(-Math.sin(yawRad) * Math.cos(pitchRad), -Math.sin(pitchRad), Math.cos(yawRad) * Math.cos(pitchRad));
+		Vec3 eye = player.getEyePosition();
+		float damage = skyrimDamage * SKYRIM_TO_MC;
+		if (kind == Proto.SWING_ARROW) {
+			arrow(player, level, eye, look, damage * (0.25F + 0.75F * Math.max(0.0F, Math.min(1.0F, charge))));
+		} else {
+			melee(player, level, eye, look, damage, kind == Proto.SWING_POWER ? 3 : 1);
+		}
+	}
+
+	/**
+	 * Skyrim hurt the stand-in of a mob (see {@link MobProxies}). If the player did it (a spell, say, cast at the mob they locked on to) the
+	 * mob takes it as the player's own hit, so it drops what it drops and turns on them. Otherwise an NPC did it, and the mob takes the
+	 * blow as from the NPC nearest it, so it turns on that NPC the way it would on one that hit it.
+	 */
+	public static void proxyHurt(ServerPlayer player, int mobId, float skyrimDamage, boolean byPlayer) {
+		ServerLevel level = player.level();
+		if (!(level.getEntity(mobId) instanceof Mob mob) || !mob.isAlive() || skyrimDamage <= 0.0F) {
+			if (proxyLogs++ < 60) {
+				SkyCraft.LOG.info("SkyCraft: Skyrim hurt stand-in of mob {} for {}, but there is no live mob to take it", mobId, skyrimDamage);
+			}
+			return;
+		}
+		if (byPlayer) {
+			boolean hurt = mob.hurtServer(level, level.damageSources().playerAttack(player), skyrimDamage * SKYRIM_TO_MC);
+			if (proxyLogs++ < 60) {
+				SkyCraft.LOG.info("SkyCraft: Skyrim player hurt {} for {}: {}", mob.getName().getString(), skyrimDamage * SKYRIM_TO_MC, hurt ? "landed" : "refused");
+			}
+			return;
+		}
+		SkyrimActorEntity attacker = null;
+		double best = 12.0 * 12.0;
+		for (SkyrimActorEntity npc : level.getEntitiesOfClass(SkyrimActorEntity.class, mob.getBoundingBox().inflate(12.0))) {
+			double d = npc.isAlive() ? npc.distanceToSqr(mob) : Double.MAX_VALUE;
+			if (d < best) {
+				best = d;
+				attacker = npc;
+			}
+		}
+		var source = attacker != null ? level.damageSources().mobAttack(attacker) : level.damageSources().generic();
+		// An NPC at arm's length struck it; one further off shot it (and the shot keeps its knockback).
+		boolean closeBlow = attacker != null && Math.sqrt(best) < 3.5;
+		boolean hurt = closeBlow ? NoShove.hurt(level, mob, source, skyrimDamage * SKYRIM_TO_MC) : mob.hurtServer(level, source, skyrimDamage * SKYRIM_TO_MC);
+		if (proxyLogs++ < 60) {
+			SkyCraft.LOG.info("SkyCraft: Skyrim NPC hurt {} for {}: {}", mob.getName().getString(), skyrimDamage * SKYRIM_TO_MC, hurt ? "landed" : "refused");
+		}
+	}
+
+	private static int proxyLogs;
+
+	private static void melee(ServerPlayer player, ServerLevel level, Vec3 eye, Vec3 look, float damage, int most) {
+		List<Mob> inReach = new ArrayList<>();
+		for (Mob mob : level.getEntitiesOfClass(Mob.class, player.getBoundingBox().inflate(MELEE_REACH + 2.0))) {
+			if (!mob.isAlive() || mob.isAlliedTo(player)) {
+				continue;
+			}
+			AABB box = mob.getBoundingBox();
+			double gap = Math.sqrt(box.distanceToSqr(eye));
+			if (gap > MELEE_REACH) {
+				continue;
+			}
+			Vec3 to = box.getCenter().subtract(eye);
+			double length = to.length();
+			if (gap > 1.0 && length > 1.0E-6 && to.scale(1.0 / length).dot(look) < MELEE_CONE) {
+				continue;
+			}
+			if (SkyrimMobs.canSee(player, mob)) {
+				inReach.add(mob);
+			}
+		}
+		inReach.sort(Comparator.comparingDouble(mob -> mob.distanceToSqr(player)));
+		for (int i = 0; i < Math.min(most, inReach.size()); i++) {
+			Mob mob = inReach.get(i);
+			boolean hurt = NoShove.hurt(level, mob, level.damageSources().playerAttack(player), damage);
+			SkyCraft.LOG.info("SkyCraft: Skyrim swing hit {} for {}{}", mob.getName().getString(), damage, hurt ? "" : " (no effect)");
+		}
+	}
+
+	private static void arrow(ServerPlayer player, ServerLevel level, Vec3 eye, Vec3 look, float damage) {
+		Vec3 end = eye.add(look.scale(ARROW_RANGE));
+		Mob best = null;
+		double bestDistance = Double.MAX_VALUE;
+		for (Mob mob : level.getEntitiesOfClass(Mob.class, new AABB(eye, end).inflate(1.0))) {
+			if (!mob.isAlive() || mob.isAlliedTo(player)) {
+				continue;
+			}
+			Optional<Vec3> at = mob.getBoundingBox().inflate(0.2).clip(eye, end);
+			if (at.isEmpty()) {
+				continue;
+			}
+			double distance = eye.distanceToSqr(at.get());
+			if (distance < bestDistance && SkyClip.cast(eye, at.get()) == null) {
+				best = mob;
+				bestDistance = distance;
+			}
+		}
+		if (best != null) {
+			boolean hurt = best.hurtServer(level, level.damageSources().playerAttack(player), damage);
+			SkyCraft.LOG.info("SkyCraft: Skyrim arrow hit {} for {}{}", best.getName().getString(), damage, hurt ? "" : " (no effect)");
+		}
+	}
+}
